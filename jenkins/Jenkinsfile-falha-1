// PIPELINE COM FALHA 1 - Erro de Compilacao (codigo invalido)
// Status esperado: FAILURE no stage 'Compilacao'
//
// Falha: Copia BrokenService.java (com erro de sintaxe) para src/ antes de compilar.
// Erro: "java: ';' expected"
// Correcao: Corrigir o erro de sintaxe no codigo-fonte antes do push.

pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    environment {
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validacao do Ambiente') {
            steps {
                sh 'java -version'
                sh 'mvn --version'
            }
        }

        stage('Injetar Codigo com Erro') {
            steps {
                sh 'cp jenkins/broken-files/BrokenService.java src/main/java/com/br/streaming/flix/service/BrokenService.java'
            }
        }

        stage('Compilacao') {
            steps {
                sh 'mvn clean compile -DskipTests'
            }
        }

        stage('Testes') {
            steps {
                sh 'mvn test -Dspring.profiles.active=test'
            }
        }
    }

    post {
        failure {
            echo '''
            DIAGNOSTICO: Erro de compilacao no BrokenService.java - falta ponto e virgula.
            O compilador Java exige que toda instrucao termine com ";".
            SOLUCAO: Corrigir o codigo e rodar 'mvn compile' localmente antes do push.
            '''
        }
    }
}
