// PIPELINE COM FALHA 1 - Erro de Compilacao (codigo invalido)
// Status esperado: FAILURE no stage 'Compilacao'
//
// Falha: Injeta um arquivo .java com erro de sintaxe proposital.
// Erro: "java: ';' expected" - o compilador nao consegue processar o codigo.
// Correcao: Corrigir o erro de sintaxe no codigo-fonte antes do push.

pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    environment {
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validacao do Ambiente') {
            steps {
                sh 'java -version'
                sh 'mvn --version'
            }
        }

        stage('Injetar Codigo com Erro') {
            steps {
                sh '''
                    mkdir -p src/main/java/com/br/streaming/flix/service
                    cat > src/main/java/com/br/streaming/flix/service/BrokenService.java << 'JAVAEOF'
package com.br.streaming.flix.service;

import org.springframework.stereotype.Service;

@Service
public class BrokenService {

    // ERRO INTENCIONAL: falta ponto e virgula e tipo de retorno invalido
    public String getMessage() {
        String msg = "Hello"
        return msg;
    }
}
JAVAEOF
                '''
            }
        }

        stage('Compilacao') {
            steps {
                sh 'mvn clean compile -DskipTests'
            }
        }

        stage('Testes') {
            steps {
                sh 'mvn test'
            }
        }
    }

    post {
        always {
            sh 'rm -f src/main/java/com/br/streaming/flix/service/BrokenService.java'
        }
        failure {
            echo '''
            DIAGNOSTICO: Erro de compilacao - falta ponto e virgula no BrokenService.java.
            O compilador Java exige que toda instrucao termine com ";".
            SOLUCAO: Corrigir o codigo-fonte e rodar 'mvn compile' localmente antes do push.
            '''
        }
    }
}
